.program spi_write
; Write data over SPI
; First 4 bytes are length in bits (stored in x)
; Then data to write
.side_set 2

.wrap_target
	pull block side 2
	out x 32 side 0
send_loop:
	out pins 1 side 0
	jmp x-- send_loop side 1
	set pins 0 side 2
.wrap

.program spi_read_passthru
; Bulk read data over SPI, copying to passthru device
; First 4 bytes are length in bits (stored in x)
; Then write command + address, finally data
.side_set 5

.wrap_target
	pull block side 0x1A		; wait for new start address
	set x 31 side 0x18
addr_send: 						; send read command + address (5 bytes) to chip via QSPI
	out pins 1 side 0x18
	jmp x-- addr_send side 0x19
	out x 32 side 0x10			; load length count
data_recv:
	in pins 1 side 0x15
	jmp x-- data_recv side 0x10
	push side 0x1A
	nop side 0x0A				; LDAC low to load
.wrap

% c-sdk {
void spi_write_program_init(PIO pio, uint state_machine, uint offset,
							 uint sclk_pin, uint si_pin){
	pio_sm_config config = spi_write_program_get_default_config(offset);

	sm_config_set_out_pins(&config, si_pin, 1);
 	sm_config_set_set_pins(&config, si_pin, 1);
	pio_sm_set_consecutive_pindirs(pio, state_machine, si_pin, 1, true);

	// ce_n pin is sclk pin + 1
 	sm_config_set_sideset_pins(&config, sclk_pin);
	pio_sm_set_consecutive_pindirs(pio, state_machine, sclk_pin, 2, true);

	pio_gpio_init(pio, si_pin);
	pio_gpio_init(pio, sclk_pin);
	pio_gpio_init(pio, sclk_pin + 1);

	sm_config_set_clkdiv(&config, 12.f);

	sm_config_set_in_shift(&config, false, true, 32);
	sm_config_set_out_shift(&config, false, true, 32);

	pio_sm_init(pio, state_machine, offset, &config);
}

void spi_read_passthru_program_init(PIO pio, uint state_machine, uint offset,
									uint sclk_pin, uint so_pin, uint si_pin){
	pio_sm_config config = spi_read_passthru_program_get_default_config(offset);

	sm_config_set_in_pins(&config, so_pin);
	sm_config_set_out_pins(&config, si_pin, 1);
 	sm_config_set_set_pins(&config, si_pin, 1);
	pio_sm_set_consecutive_pindirs(pio, state_machine, si_pin, 1, true);

	// ce_n pin is sclk pin + 1; then duplicate for passthru, finally LDAC
 	sm_config_set_sideset_pins(&config, sclk_pin);
	pio_sm_set_consecutive_pindirs(pio, state_machine, sclk_pin, 5, true);

	pio_gpio_init(pio, si_pin);
	pio_gpio_init(pio, so_pin);
	gpio_set_input_enabled(so_pin, true);
	gpio_pull_up(so_pin);
	gpio_set_input_hysteresis_enabled(so_pin, true);
	pio_gpio_init(pio, sclk_pin);
	pio_gpio_init(pio, sclk_pin + 1);
	pio_gpio_init(pio, sclk_pin + 2);
	pio_gpio_init(pio, sclk_pin + 3);
	pio_gpio_init(pio, sclk_pin + 4);

	hw_set_bits(&pio->input_sync_bypass, 0x1u << so_pin);

	sm_config_set_clkdiv(&config, 12.f);

	sm_config_set_in_shift(&config, false, true, 32);
	sm_config_set_out_shift(&config, false, true, 32);

	pio_sm_init(pio, state_machine, offset, &config);
}
%}
